# HTTP to HTTPS redirect
server {
    listen 80;
    server_name {{ domain_name }} www.{{ domain_name }};

    # Redirect all HTTP traffic to HTTPS
    return 301 https://$server_name$request_uri;
}

# HTTPS server with SSL
server {
    listen 443 ssl;
    http2 on;
    server_name {{ domain_name }} www.{{ domain_name }};

    # SSL configuration
    ssl_certificate /etc/ssl/certs/cert.pem;
    ssl_certificate_key /etc/ssl/certs/key.pem;

    # Main content location
    location / {
        proxy_pass http://app:{{ app_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Health check endpoint
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # Simple test page
    location /test {
        return 200 "<h1>Guest in the Universe is live!</h1><p>Let's explore this vast universe.</p>";
        add_header Content-Type text/html;
    }

    # OCI Object Storage proxy for images
    location /images/ {
        rewrite ^/images/(.*)$ /n/{{ oci_namespace }}/b/{{ oci_bucket }}/o/images/$1 break;
        proxy_pass https://{{ oci_namespace }}.objectstorage.{{ oci_region }}.oci.customer-oci.com;
        proxy_set_header Host {{ oci_namespace }}.objectstorage.{{ oci_region }}.oci.customer-oci.com;
    }
}
